<div class="container">
  <header>
    <div class="container">
      <h1>My Blog</h1>
      <nav>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <article class="post">
      <h1><%= @post.title %></h1>
      <div class="post-meta">
        <span><%= @post.created_at.strftime("%B %d, %Y") %></span>
      </div>
      <div class="post-content">
        <p><%= @post.body %></p>
      </div>
      <div style="margin-top: 2rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <%= link_to "Back to posts", root_path, class: "btn" %>
        <%= link_to "Edit", "/posts/#{@post.id}/edit", class: "btn", style: "background: var(--text-muted);" %>
        <%= link_to "Delete", "/posts/#{@post.id}", data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn", style: "background: #ef4444;" %>
      </div>
    </article>
  </main>

  <footer>
    <p>&copy; 2026 My Blog. All rights reserved.</p>
  </footer>
</div>