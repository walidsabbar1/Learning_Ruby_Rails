<div class="container">
  <header>
    <div class="container" style="padding: 0;">
      <h1>My Blog</h1>
      <nav>
        <a href="/">Home</a>
      </nav>
    </div>
  </header>

  <main>
    <article class="post">
      <h1 style="margin-bottom: 2rem;">New Post</h1>
      <%= form_with model: @post, url: '/posts' do |form| %>
        <div class="field" style="margin-bottom: 1.5rem;">
            <%= form.label :title, style: "display: block; font-weight: 600; margin-bottom: 0.5rem;" %>
            <%= form.text_field :title, class: "form-control" %>
        </div>
        <div class="field" style="margin-bottom: 1.5rem;">
            <%= form.label :body, style: "display: block; font-weight: 600; margin-bottom: 0.5rem;" %>
            <%= form.text_area :body, rows: 6, class: "form-control" %>
        </div>
        <div class="actions" style="margin-top: 2rem;">
            <%= form.submit "Create Post", class: "btn" %>
            <%= link_to "Cancel", root_path, class: "btn", style: "background: var(--text-muted); margin-left: 0.5rem;" %>
        </div>
      <% end %>
    </article>
  </main>

  <footer>
    <p>&copy; 2026 My Blog. All rights reserved.</p>
  </footer>
</div>