<div class="container">
  <header>
    <div class="container">
      <h1>My Blog</h1>
      <nav>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
      </nav>
    </div>
  </header>

  <div style="margin-bottom: 2rem; display: flex; justify-content: flex-end;">
    <%= link_to "New Post", "/posts/new", class: "btn" %>
  </div>

  <main>
    <% @posts.each do |post| %>
      <article class="post">
        <h2><%= link_to post.title, "/posts/#{post.id}" %></h2>
        <div class="post-meta">
          <span><%= post.created_at.strftime("%B %d, %Y") %></span>
        </div>
        <div class="post-content">
          <p><%= post.body %></p>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <%= link_to "Read More", "/posts/#{post.id}", class: "btn" %>
          <%= link_to "Edit", "/posts/#{post.id}/edit", class: "btn", style: "background: var(--text-muted);" %>
          <%= link_to "Delete", "/posts/#{post.id}", data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn", style: "background: #ef4444;" %>
        </div>
      </article>
    <% end %>
  </main>

  <footer>
    <p>&copy; 2026 My Blog. All rights reserved.</p>
  </footer>
</div>
