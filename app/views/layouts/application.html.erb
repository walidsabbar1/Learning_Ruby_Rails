<!DOCTYPE html>
<html>
  <head>
    <title>My Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag 'favicon.png' %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice.present? %>
      <div style="background: #10b981; color: white; text-align: center; padding: 0.75rem; font-weight: 600;"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div style="background: #ef4444; color: white; text-align: center; padding: 0.75rem; font-weight: 600;"><%= alert %></div>
    <% end %>

    <header style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 1000; transition: var(--transition);">
      <div class="container" style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; padding: 1rem 2rem; margin: 0 auto;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="background: linear-gradient(135deg, var(--primary), #8b5cf6); width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 1.25rem; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);">B</div>
          <h1 style="margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.025em;">
            <a href="/" style="text-decoration: none; color: #0f172a;">My Blog</a>
          </h1>
        </div>
        
        <nav style="display: flex; align-items: center; gap: 1.5rem;">
          <% if user_signed_in? %>
            <div style="display: flex; align-items: center; gap: 0.75rem; padding-right: 1.5rem; border-right: 1px solid var(--border-color);">
              <img src="https://www.gravatar.com/avatar/<%= Digest::MD5.hexdigest(current_user.email.downcase) %>?s=36&d=mp" alt="Avatar" style="width: 36px; height: 36px; border-radius: 50%; border: 2px solid white; box-shadow: var(--shadow-sm);">
              <span style="font-weight: 600; color: var(--text-main); font-size: 0.95rem;"><%= (current_user.username.presence || current_user.email.split('@').first).capitalize %></span>
            </div>
            <%= link_to "Write a Post", "/posts/new", class: "btn", style: "padding: 0.5rem 1.25rem; border-radius: 9999px; background: #0f172a; font-size: 0.9rem;" %>
            
            <div class="dropdown" style="position: relative; top: auto; right: auto; display: flex; align-items: center;">
              <button class="dropbtn" style="width: 36px; height: 36px; padding: 0; border-radius: 50%; color: var(--text-muted); display: flex; align-items: center; justify-content: center; background: #f1f5f9; border: 1px solid var(--border-color);">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
              </button>
              <div class="dropdown-content" style="top: 100%; right: 0; min-width: 180px; margin-top: 0.5rem;">
                <%= link_to "Edit Profile", edit_user_registration_path, style: "font-weight: 600; font-size: 0.9rem; padding: 12px 16px;" %>
                <div style="height: 1px; background: var(--border-color); margin: 4px 0;"></div>
                <%= link_to "Logout", destroy_user_session_path, style: "font-weight: 600; color: #ef4444; font-size: 0.9rem; padding: 12px 16px;" %>
              </div>
            </div>
          <% else %>
            <%= link_to "Log in", new_user_session_path, style: "color: var(--text-muted); font-weight: 600; font-size: 0.95rem; transition: color 0.2s;" %>
            <%= link_to "Sign up", new_user_registration_path, class: "btn", style: "padding: 0.5rem 1.25rem; border-radius: 9999px; background: #0f172a; font-size: 0.95rem;" %>
          <% end %>
        </nav>
      </div>
    </header>

    <div style="min-height: calc(100vh - 200px);">
      <%= yield %>
    </div>

    <footer style="background: var(--card-bg); border-top: 1px solid var(--border-color); padding: 3rem 0; margin-top: auto;">
      <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="background: var(--text-muted); width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 0.9rem;">B</div>
          <span style="font-weight: 700; color: var(--text-main); font-size: 1rem;">My Blog</span>
        </div>
        <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0; font-weight: 500;">&copy; <%= Time.current.year %> All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
