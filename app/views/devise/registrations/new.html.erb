<div class="container">
  <div class="post" style="max-width: 500px; margin: 0 auto;">
    <h2 style="text-align: center; margin-bottom: 2rem; color: var(--primary);">Sign up</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field" style="margin-bottom: 1.5rem;">
        <%= f.label :username, style: "display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main);" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username", placeholder: "Choose a display name" %>
      </div>

      <div class="field" style="margin-bottom: 1.5rem;">
        <%= f.label :email, style: "display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main);" %>
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <div class="field" style="margin-bottom: 1.5rem;">
        <%= f.label :password, style: "display: block; font-weight: 600; margin-bottom: 0.25rem; color: var(--text-main);" %>
        <% if @minimum_password_length %>
          <div style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 0.5rem;">(<%= @minimum_password_length %> characters minimum)</div>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <div class="field" style="margin-bottom: 1.5rem;">
        <%= f.label :password_confirmation, style: "display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main);" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="actions" style="margin-top: 2rem;">
        <%= f.submit "Sign up", class: "btn", style: "width: 100%; display: block; text-align: center; font-size: 1.125rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 2rem; text-align: center; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
