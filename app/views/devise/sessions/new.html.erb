<div class="container">
  <div class="post" style="max-width: 500px; margin: 0 auto;">
    <h2 style="text-align: center; margin-bottom: 2rem; color: var(--primary);">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field" style="margin-bottom: 1.5rem;">
        <%= f.label :email, style: "display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main);" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field" style="margin-bottom: 1.5rem;">
        <%= f.label :password, style: "display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main);" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, style: "font-weight: 600; color: var(--text-muted);" %>
        </div>
      <% end %>

      <div class="actions" style="margin-top: 2rem;">
        <%= f.submit "Log in", class: "btn", style: "width: 100%; display: block; text-align: center; font-size: 1.125rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 2rem; text-align: center; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
